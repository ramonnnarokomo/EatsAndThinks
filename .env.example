# Copia este fichero como .env (está en el .gitignore) y rellena los valores.
# Docker Compose lo lee solo al hacer docker-compose up.

# API key de Google Cloud con Places API y Maps JavaScript API activadas.
# Restríngela por API y por dominio en la consola de Google Cloud.
GOOGLE_PLACES_API_KEY=

# Secreto para firmar los JWT: mínimo 32 caracteres aleatorios.
# Linux / Mac:  openssl rand -hex 32
# PowerShell:   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | % { $_.ToString('x2') }) -join ''
JWT_SECRET=
